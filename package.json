{
  "name": "prikdatum",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "node tools/deploy.mjs",
    "db:local": "wrangler d1 execute prikdatum --local --file=schema.sql && (wrangler d1 execute prikdatum --local --file=migrations/0002_levenscyclus.sql >/dev/null 2>&1 || true)",
    "db:remote": "wrangler d1 execute prikdatum --remote --file=schema.sql",
    "test": "playwright test",
    "deploy:dirty": "node tools/deploy.mjs --allow-dirty",
    "db:migrate": "wrangler d1 execute prikdatum --remote --file=migrations/0002_levenscyclus.sql"
  },
  "devDependencies": {
    "@fontsource/noto-sans-tifinagh": "^5.3.0",
    "@playwright/test": "^1.50",
    "wrangler": "^4"
  }
}
